---
import { reasons } from '../data/site';
---

<section id="why-me" class="section section-dark">
  <div class="container">
    <div class="row g-5">
      <div class="col-lg-4">
        <h2>Why Choose Me</h2>

        <p class="text-light-muted">
          A quality finish starts with good preparation,
          careful workmanship and attention to detail.
          Here's what I bring to every project.
        </p>

        <a href="#contact" class="btn btn-accent mt-2">
          Discuss Your Project
        </a>
      </div>

      <div class="col-lg-8">
        <div class="row g-4">
          {reasons.map((r) => (
            <div class="col-md-6">
              <div class="reason d-flex gap-3">
                <i class={`bi ${r.icon}`} aria-hidden="true"></i>
                <div>
                  <h3>{r.title}</h3>
                  <p class="mb-0">{r.text}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ========================================
     WHY CHOOSE ME
  ======================================== */

  .section-dark {
    background: var(--navy);
    color: #fff;
  }

  /* ========================================
     INTRODUCTION
  ======================================== */

  .section-dark h2 {
    margin-bottom: 1rem;
    color: #fff;
    font-weight: 800;
  }

  .text-light-muted {
    max-width: 30rem;
    margin-bottom: 1.5rem;
    color: #d1dbea;
    font-size: 1rem;
    line-height: 1.7;
  }

  /* Call to action */

  .section-dark .btn {
    font-size: 0.9rem;
    padding: 0.75rem 1.35rem;
  }

  /* ========================================
     REASONS
  ======================================== */

  .reason {
    height: 100%;
    min-width: 0;
  }

  .reason .bi {
    flex: none;
    color: var(--orange);
    font-size: 1.7rem;
    line-height: 1.2;
  }

  .reason > div {
    min-width: 0;
  }

  .reason h3 {
    margin-bottom: 0.5rem;
    color: #fff;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .reason p {
    margin-bottom: 0;
    color: #d1dbea;
    font-size: 0.95rem;
    line-height: 1.65;
  }

  /* ========================================
     TABLET
  ======================================== */

  @media (max-width: 991.98px) {
    .section-dark > .container > .row {
      --bs-gutter-y: 2rem;
    }

    .text-light-muted {
      max-width: 40rem;
    }
  }

  /* ========================================
     MOBILE
  ======================================== */

  @media (max-width: 767.98px) {
    .section-dark h2 {
      font-size: clamp(1.5rem, 6vw, 1.9rem);
    }

    .text-light-muted {
      margin-bottom: 1rem;
      font-size: 0.9rem;
      line-height: 1.6;
    }

    .reason {
      gap: 0.75rem !important;
    }

    .reason .bi {
      font-size: 1.4rem;
    }

    .reason h3 {
      margin-bottom: 0.35rem;
      font-size: 1rem;
    }

    .reason p {
      font-size: 0.875rem;
      line-height: 1.6;
    }

    .section-dark .btn {
      font-size: 0.875rem;
      padding: 0.7rem 1.15rem;
    }
  }
</style>