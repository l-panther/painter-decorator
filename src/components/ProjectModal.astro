
---
import BeforeAfter from './BeforeAfter.astro';
import VideoComparison from './VideoComparison.astro';
import type { Project } from '../data/site';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;

const base = import.meta.env.BASE_URL;
const asset = (path: string) =>
  `${base}${path.replace(/^\/+/, '')}`;

const hasComparison =
  project.type !== 'single' &&
  Boolean(project.before && project.after);

const hasVideo = Boolean(
  project.videos?.enabled &&
  project.videos.before &&
  project.videos.after
);
---

<div
  class="modal fade project-modal"
  id={`projectModal-${index}`}
  tabindex="-1"
  aria-labelledby={`projectModalTitle-${index}`}
  aria-hidden="true"
>
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">

      <!-- Header -->
      <div class="modal-header project-modal-header">
        <div class="project-modal-heading">
          <span class="project-modal-category">
            {project.place}
          </span>

          <h2 class="modal-title" id={`projectModalTitle-${index}`}>
            {project.title}
          </h2>

          <p>{project.description}</p>
        </div>

        <button
          type="button"
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
          aria-label={`Close ${project.title} project`}
        ></button>
      </div>

      <!-- Scrollable body -->
      <div class="modal-body project-modal-body">

        <!-- Top row: Images + About -->
        <div class="project-modal-main">

          <div class="project-modal-media">
            {hasComparison ? (
              <BeforeAfter
                before={asset(project.before!)}
                after={asset(project.after!)}
                title={project.title}
                type={project.type as 'static' | 'slider'}
              />
            ) : project.image ? (
              <img
                src={asset(project.image)}
                alt={project.title}
                class="project-modal-single-image"
                loading="lazy"
                decoding="async"
              />
            ) : null}
          </div>

          <div class="project-modal-overview">
            <h3>About This Project</h3>
            <p>
              {project.details?.overview ?? project.description}
            </p>
          </div>

        </div>

        <!-- Full width: Work involved -->
        {project.details?.preparation && (
          <div class="project-modal-process">
            <h3>Work Involved</h3>

            <ul>
              {project.details.preparation.map((step: string) => (
                <li>
                  <i class="bi bi-check2-circle" aria-hidden="true"></i>
                  <span>{step}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Full width: Result -->
        {project.details?.finish && (
          <div class="project-modal-result">
            <span class="project-modal-eyebrow">
              The Result
            </span>
            <p>{project.details.finish}</p>
          </div>
        )}

        <!-- Video walkthrough -->
        {hasVideo && project.videos && (
          <section
            class="project-modal-videos"
            aria-labelledby={`projectVideosTitle-${index}`}
          >
            <span class="project-modal-eyebrow">
              Video Walkthrough
            </span>

            <h3 id={`projectVideosTitle-${index}`}>
              Before &amp; After
            </h3>
            <p>Explore the project in more detail.</p>

            <VideoComparison
              before={asset(project.videos.before)}
              after={asset(project.videos.after)}
              title={project.title}
            />
          </section>
        )}

      </div>

      <!-- Footer -->
      <div class="modal-footer project-modal-footer">
        <button
          type="button"
          class="btn btn-outline-secondary"
          data-bs-dismiss="modal"
        >
          Close Project
        </button>
      </div>

    </div>
  </div>
</div>

<style>
  /* ========================================
     PROJECT MODAL
  ======================================== */

  .project-modal .modal-content {
    overflow: hidden;
    border: 0;
    border-radius: 0.75rem;
  }

  /* ========================================
     HEADER
  ======================================== */

  .project-modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.75rem 2rem;
    border: 0;
    background: var(--navy);
    color: #fff;
  }

  .project-modal-heading {
    flex: 1;
    min-width: 0;
  }

  .project-modal-category {
    display: block;
    margin-bottom: 0.5rem;
    color: #9ecbf0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-modal-header h2 {
    margin-bottom: 0.5rem;
    color: #fff;
    font-size: clamp(1.35rem, 3vw, 1.8rem);
    font-weight: 700;
    line-height: 1.3;
  }

  .project-modal-header p {
    margin: 0;
    color: #d1dfef;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .project-modal-header .btn-close {
    flex-shrink: 0;
    margin: 0;
    opacity: 0.85;
  }

  .project-modal-header .btn-close:hover {
    opacity: 1;
  }

  /* ========================================
     BODY
  ======================================== */

  .project-modal-body {
    padding: 2rem;
    background: #fff;
  }

  .project-modal-body h3 {
    margin-bottom: 0.75rem;
    color: var(--navy);
    font-size: 1.1rem;
    font-weight: 700;
  }

  .project-modal-body p {
    font-size: 0.9rem;
    line-height: 1.65;
  }

  /* ========================================
     MAIN CONTENT
  ======================================== */

  .project-modal-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: 1.75rem;
    margin-bottom: 1.75rem;
  }

  .project-modal-overview {
    min-width: 0;
  }

  .project-modal-overview p {
    margin: 0;
    color: var(--ink);
  }

  /* ========================================
     PROJECT MEDIA
  ======================================== */

  .project-modal-media {
    width: 100%;
    min-width: 0;
    overflow: hidden;
    border-radius: 0.5rem;
    background: var(--tint);
  }

  /* Comparison components */

  .project-modal-media :global(.comparison-static),
  .project-modal-media :global(.comparison-slider) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
  }

  /* Static before / after */

  .project-modal-media :global(.comparison-static) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3px;
  }

  /* Interactive comparison */

  .project-modal-media :global(.comparison-slider) {
    overflow: hidden;
  }

  /* Standalone photographs */

.project-modal-single-image {
  display: block;
  width: 100%;
  height: auto;
  object-fit: contain;
}

  /* ========================================
     WORK INVOLVED
  ======================================== */

  .project-modal-process {
    padding: 1.5rem 0;
    border-top: 1px solid #e1eaf3;
  }

  .project-modal-process h3 {
    margin-bottom: 1.25rem;
  }

  .project-modal-process ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1.5rem;
    row-gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-modal-process li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    color: var(--ink);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .project-modal-process li i {
    flex-shrink: 0;
    margin-top: 0.1rem;
    color: var(--blue);
  }

  /* ========================================
     RESULT
  ======================================== */

  .project-modal-result {
    margin-top: 0.5rem;
    padding: 1.25rem 1.5rem;
    border-left: 3px solid var(--orange);
    border-radius: 0.35rem;
    background: var(--tint);
  }

  .project-modal-eyebrow {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--blue-dark);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .project-modal-result p {
    margin: 0;
    color: var(--ink);
  }

  /* ========================================
     VIDEO WALKTHROUGH
  ======================================== */

  .project-modal-videos {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid #e2e8f0;
  }

  .project-modal-videos > p {
    margin-bottom: 1.5rem;
    color: var(--muted);
  }

  /* ========================================
     FOOTER
  ======================================== */

  .project-modal-footer {
    padding: 1rem 2rem;
    border-top: 1px solid #e2e8f0;
    background: #f8fafc;
  }

  /* ========================================
     DESKTOP
  ======================================== */

  @media (min-width: 992px) {
    .project-modal .modal-dialog {
      width: calc(100% - 4rem);
      max-width: 1100px;
    }
  }

  /* ========================================
     TABLET
  ======================================== */

  @media (min-width: 768px) and (max-width: 991.98px) {
    .project-modal .modal-dialog {
      width: calc(100% - 2rem);
      max-width: none;
    }
  }

  /* ========================================
     MOBILE
  ======================================== */

  @media (max-width: 767.98px) {
    .project-modal-header {
      gap: 1rem;
      padding: 1.25rem;
    }

    .project-modal-header h2 {
      font-size: 1.3rem;
    }

    .project-modal-header p {
      font-size: 0.85rem;
    }

    .project-modal-body {
      padding: 1.25rem;
    }

    .project-modal-body h3 {
      font-size: 1rem;
    }

    .project-modal-main {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .project-modal-process ul {
      grid-template-columns: 1fr;
    }

    .project-modal-process li {
      font-size: 0.875rem;
    }

    .project-modal-footer {
      padding: 1rem 1.25rem;
    }
  }

  /* ========================================
     SMALL PHONES
  ======================================== */

  @media (max-width: 575.98px) {
    .project-modal-header,
    .project-modal-body {
      padding: 1rem;
    }

    .project-modal-header h2 {
      font-size: 1.2rem;
    }

    .project-modal-result {
      padding: 1rem;
    }

    .project-modal-footer {
      padding: 0.85rem 1rem;
    }
  }
</style>

<script>
  function initProjectModals() {
    document
      .querySelectorAll<HTMLElement>('.project-modal')
      .forEach((modal) => {
        if (modal.dataset.initialized === 'true') return;

        modal.dataset.initialized = 'true';

        modal.addEventListener('hidden.bs.modal', () => {
          modal
            .querySelectorAll<HTMLVideoElement>('video')
            .forEach((video) => video.pause());
        });
      });
  }

  document.addEventListener('astro:page-load', initProjectModals);
  initProjectModals();
</script>
