---
import { site } from '../data/site';
import { asset } from '../utils/paths';

const base = import.meta.env.BASE_URL;
---

<header id="home" class="hero">
  <div class="container">
    <div class="row align-items-center g-4 g-lg-5">
      <div class="col-lg-6 hero-text">
        <h1>Transforming spaces with care.</h1>
        <img src={asset('images/paint-stroke.png')} alt="Decorative orange paint stroke" />
        <p class="lead">
          Interior and exterior painting and decorating for homes
          and businesses across {site.area}. From careful surface
          preparation to the final coat, I focus on quality
          workmanship, attention to detail and a clean,
          professional finish.
        </p>
        <div class="d-flex flex-wrap gap-3">
          <a href="#contact" class="btn btn-accent btn-lg">Get a free quote</a>
          <a href="#gallery" class="btn btn-outline-brand btn-lg">See my work</a>
        </div>
      </div>
      <div class="col-lg-6">
        <picture>
          <source
            srcset={asset('images/hero/hero.png')}
            media="(min-width: 992px)"
          />
          <img
            class="hero-img"
            src={asset('images/hero/hero.png')}
            alt="A painter rolling blue paint onto a wall, with a stepladder, paint tins and a brush on a dust sheet"
            fetchpriority="high"
          />
        </picture>
        
      </div>
    </div>
  </div>
</header>

<style>
  /* ========================================
     HERO
  ======================================== */

  .hero {
    background: var(--navy);
    background:
    radial-gradient(
      50% 45% at 32% 35%,
      rgba(74, 128, 181, 0.762) 0%,
      rgba(49, 87, 144, 0.371) 65%
    ),
    var(--navy);
    padding: 4rem 0 4.5rem;
    overflow: hidden;
    color: #fff;
  }

  .hero h1 {
    margin-bottom: 1rem;
    font-size: clamp(2.2rem, 5vw, 3.3rem);
    font-weight: 800;
    line-height: 1.08;
  }

  .hero .lead {
    max-width: 34rem;
    margin: 1.75rem 0;
    font-size: 1.125rem;
    line-height: 1.65;
  }

  /* Decorative paint stroke */

  .hero-stroke {
    display: block;
    width: auto;
    max-width: 65%;
    height: auto;
  }

  /* Hero illustration */

  .hero-img {
    display: block;
    width: 60%;
    max-width: 100%;
    margin: auto;
    height: auto;
  }

  /* ========================================
     DESKTOP
  ======================================== */

  @media (min-width: 992px) {
    .hero {
      padding: 4rem 0;
      overflow: visible;
    }

    .hero-img {
      width: 80%;
      transform: none;
    }

    .hero .col-lg-6:last-child { padding: 0; }

    .hero-text {
      padding: 0 0 3rem 2rem;
    }
  }

  /* ========================================
     MOBILE
  ======================================== */

  @media (max-width: 767.98px) {
    .hero {
      padding-top: 2rem;
    }

    .hero h1 {
      font-size: clamp(1.9rem, 7vw, 2.5rem);
      line-height: 1.15;
    }

    .hero .lead {
      margin: 1.25rem 0;
      font-size: 1rem;
      line-height: 1.6;
    }

    .hero-stroke {
      max-width: 55%;
    }

    .hero .btn {
      font-size: 0.875rem;
      padding: 0.7rem 1.15rem;
    }

    .hero-img {
      width: 60%;
      max-width: 100%;
    }
  }

  /* ========================================
     SMALL PHONES
  ======================================== */

  @media (max-width: 399.98px) {
    .hero h1 {
      font-size: 1.85rem;
    }

    .hero .btn {
      font-size: 0.8rem;
      padding: 0.65rem 1rem;
    }

    .hero-img {
      width: 100%;
      max-width: 100%;
    }
  }
</style>
