---
import { site } from '../data/site';
import { asset } from '../utils/paths';

const base = import.meta.env.BASE_URL;
---


<header class="hero" id="home">
  <div class="container">
    <div class="hero-content">

      <span class="hero-eyebrow">
        Professional Painting & Decorating
      </span>

      <h1>Transforming Spaces<br />With Care.</h1>

      <div class="hero-stroke" aria-hidden="true"></div>

      <img class="hero-stroke" src={asset('images/paint-stroke.png')} alt="Decorative orange paint stroke" />
      
      <p class="lead">
        Professional interior and exterior painting and decorating across Central London and surrounding areas. From careful preparation to the final coat, I deliver quality workmanship, attention to detail and a clean, professional finish.
      </p>

      <div class="hero-actions">
        <a href="#contact" class="hero-btn primary">
          Get a Free Quote
        </a>

        <a href="#portfolio" class="hero-btn secondary">
          See My Work
        </a>
      </div>

    </div>
  </div>
</header>


<style>
/* ==========================
   HERO
========================== */

.hero {
  position: relative;
  isolation: isolate;

  display: flex;
  align-items: center;

  min-height: 600px;
  padding: 80px 0;

  background-color: #084780;

  background-image:
    linear-gradient(
      90deg,
      rgba(12, 28, 53, 1) 20%,
      rgba(12, 28, 53, .65) 60%,
      rgba(12, 28, 53, .45) 100%,
      transparent 100%
    ),
    url("/images/hero/hero.webp");

  background-size: cover;
  background-position: center;

  background-repeat: no-repeat;
  color: #fff;
}

.hero .container {
  position: relative;
  z-index: 1;
  width: min(1380px, calc(100% - 40px));
  margin-inline: auto;
}

.hero-content {
  max-width: 760px;
}

.hero-eyebrow {
  display: block;
  margin-bottom: 18px;
  color: #b9dfff;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.hero h1 {
  margin: 0 0 10px;
  font-size: clamp(40px, 4.5vw, 64px);
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: -0.025em;
}

/* .hero-stroke {
  width: 190px;
  height: 5px;
  margin: 26px 0 32px;
  border-radius: 50%;
  background: #ff914d;
  transform: rotate(-2deg);
}*/

.hero-stroke {
  display: block;
  width: 40%;
  max-width: 85%;
  height: auto;
  margin: 0;
  transform: rotate(-2deg);
}

.hero-content p {
  max-width: 610px;
  margin: 25px 0 0 0;
  color: #e4edf7;
  font-size: 16px;
  line-height: 1.85;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 30px;
}

.hero-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 12px 26px;
  border: 1px solid transparent;
  border-radius: 999px;
  font-size: 0.95rem;
  font-weight: 700;
  text-decoration: none;
  text-transform: uppercase;
  transition: background .25s, color .25s;
}

.hero-btn.primary {
  background: #ff914d;
  color: #12233f;
}

.hero-btn.primary:hover {
  background: #f27a2e;
}

.hero-btn.secondary {
  border-color: rgba(255, 255, 255, 0.85);
  background: transparent;
  color: #fff;
}

.hero-btn.secondary:hover {
  background: #fff;
  color: #12233f;
}

/* LARGE DESKTOP */
@media (min-width: 1440px) {
  .hero {
    min-height: 750px;
    background-position: center center;
  }
}

/* SMALL DESKTOP */
@media (max-width: 1199px) {
  .hero {
    min-height: 650px;
    background-position: 65% center;
  }

  .hero-content {
    max-width: 480px;
  }
}

/* TABLET */
@media (max-width: 900px) {
  .hero {
    min-height: 600px;
    align-items: flex-start;
    padding: 90px 0 80px;

    background-position: 72% center;
  }

  .hero-content {
    max-width: 480px;
  }

  .hero h1 {
    font-size: clamp(36px, 5vw, 48px);
  }

  .hero-btn {
    font-size: 0.75rem;
  }
}

/* MOBILE */
@media (max-width: 600px) {
  .hero {
    min-height: 420px;
    padding: 85px 0 90px;

    background-position: 76% bottom;
  }

  .hero .container {
    width: calc(100% - 10px);
    margin: 0;
  }

  .hero-content {
    max-width: 100%;
  }

  .hero h1 {
    font-size: clamp(34px, 9vw, 43px);
  }

  .hero-content p {
    font-size: 14px;
    line-height: 1.75;
    max-width: 400px
  }

  .hero-stroke {
    width: 125px;
    margin: 20px 0 25px;
  }

  .hero-actions {
    gap: 10px;
  }

  .hero-btn {
    padding: 11px 18px;
  }
}
</style>
