---
import { asset } from '../utils/paths';

const facts = [
  {
    icon: 'bi-award',
    text: 'Around 5 years of painting and decorating experience'
  },
  {
    icon: 'bi-patch-check',
    text: 'Level 2 Diploma in Painting & Decorating'
  },
  {
    icon: 'bi-buildings',
    text: 'Experience in residential, commercial and educational settings'
  },
  {
    icon: 'bi-brush',
    text: 'Careful preparation, repairs and quality finishes'
  },
];
---

<section id="about" class="section">
  <div class="container">
    <div class="row g-5 align-items-center">

      <div class="col-lg-6 justify-content-center d-none d-lg-flex">
        <img
          class="about-img"
          src={asset('images/about.png')}
          alt="A painter rolling blue paint onto a wall, with a stepladder, paint tins and a brush on a dust sheet"
          fetchpriority="high"
        />
      </div>

      <div class="col-lg-6">
        <div class="row">
          <div class="col-lg-12">
                    
            <h2>About <span class="text-blue">Me</span></h2>

            <p class="lead-sm">
              I'm a painter and decorator with
              <strong>around five years of hands-on experience</strong>,
              delivering quality finishes through careful preparation,
              skilled workmanship and attention to detail.
            </p>

            <p class="text-muted">
              I've worked across
              <strong>residential, commercial and educational settings</strong>,
              undertaking everything from surface repairs and preparation
              to interior and exterior painting. I approach every project
              with the same commitment to quality, regardless of its size.
            </p>

            <p class="text-muted">
              For me, great decorating is about more than the final coat.
              It's about taking the time to get the details right,
              <strong>working neatly and treating every property with care
              and respect.</strong>
            </p>

            <p class="text-muted">
              Alongside painting and decorating, I have a keen interest
              in web development and digital design. It's another
              creative outlet where I can bring ideas to life through
              thoughtful design and attention to detail.
            </p>

            <a
              href="https://l-panther.github.io/portfolio/"
              class="creative-portfolio-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              <i class="bi bi-code-slash" aria-hidden="true"></i>
              <span>View My Web Development Portfolio</span>
              <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
            </a>
            </div>

          <div class="col-lg-12 pt-4">
            <div class="about-card">
              <h3 class="h5 mb-4">At a Glance</h3>

              <ul class="list-unstyled mb-0">
                {facts.map((f) => (
                  <li class="d-flex gap-3 align-items-center mb-1">
                    <i class={`bi ${f.icon}`} aria-hidden="true"></i>
                    <span>{f.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>


<style>
  /* ========================================
     ABOUT CARD
  ======================================== */

  .about-visual {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .about-img {
    display: block;
    width: 80%;
    height: auto;
  }

  .about-card {
    background: linear-gradient(30deg, #1e365d, #1e365d, var(--navy));
    color: var(--tint);
    border-radius: 1rem;
    padding: 2.5rem;
  }

  .about-card h3 {
    color: #fff;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .about-card li {
    font-size: 0.95rem;
    line-height: 1.6;
    font-weight: 500;
    color: var(--tint);
  }

  .about-card .bi {
    color: var(--orange);
    font-size: 1.5rem;
    flex: none;
  }

  /* ========================================
     PORTFOLIO LINK
  ======================================== */

  .creative-portfolio-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    max-width: 100%;
    margin-top: 0.75rem;
    color: var(--blue-dark);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.5;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .creative-portfolio-link span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .creative-portfolio-link:hover {
    color: var(--navy);
  }

  .creative-portfolio-link .bi {
    flex-shrink: 0;
  }

  .creative-portfolio-link .bi-arrow-up-right {
    font-size: 0.75rem;
    transition: transform 0.2s ease;
  }

  .creative-portfolio-link:hover .bi-arrow-up-right {
    transform: translate(2px, -2px);
  }

  /* ========================================
     TABLET
  ======================================== */

  @media (max-width: 992px) {
    .about-sm-img {
      width: 80%;
      margin: auto;
    }
  }

  /* ========================================
     MOBILE
  ======================================== */

  @media (max-width: 767.98px) {
    #about .row {
      --bs-gutter-y: 2rem;
    }

    .about-card {
      padding: 1.5rem;
      border-radius: 0.75rem;
    }

    .about-card h3 {
      font-size: 1.05rem;
    }

    .about-card li {
      font-size: 0.875rem;
      line-height: 1.5;
    }

    .about-card .bi {
      font-size: 1.2rem;
    }

    .creative-portfolio-link {
      gap: 0.5rem;
      font-size: 0.8rem;
    }
  }

  /* ========================================
     SMALL PHONE
  ======================================== */

  @media (max-width: 399.98px) {
    .about-sm-img {
      width: 90%;
      margin: auto;
    }
  }

  /* ========================================
     ACCESSIBILITY
  ======================================== */

  @media (prefers-reduced-motion: reduce) {
    .creative-portfolio-link,
    .creative-portfolio-link .bi-arrow-up-right {
      transition: none;
    }
  }
</style>
